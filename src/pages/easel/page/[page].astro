---
import EssayPageView from '../../../components/EssayPageView.astro';
import { getPageSlice, getTotalPages, getVisibleEssays, buildPaginatedPaths } from '../../../lib/content';
import { PAGE_SIZE_ESSAY } from '../../../../site.config.mjs';
import { getThemeSettings } from '../../../lib/theme-settings';

export const prerender = true;

export async function getStaticPaths() {
  const allVisibleEssays = await getVisibleEssays();
  const easelEssays = allVisibleEssays.filter(essay => essay.data.section === 'easel');
  const totalPages = getTotalPages(easelEssays.length, PAGE_SIZE_ESSAY);
  
  // Generates array paths like [{ params: { page: "2" } }, { params: { page: "3" } }]
  return buildPaginatedPaths(totalPages);
}

const { settings } = getThemeSettings();

const baseResolvedItems = settings.site.socialLinks.resolvedSocialItems.filter((item) => item.visible);
const STRATEGIC_ORDER = ['substack', 'spotify', 'x', 'instagram', 'youtube', 'email', 'kofi'];

const socialItems = baseResolvedItems.map((item) => ({
  key: item.id,
  href: item.href,
  label: item.label,
  title: item.label,
  icon: item.iconKey
})).sort((a, b) => {
  let indexA = STRATEGIC_ORDER.indexOf(a.icon);
  let indexB = STRATEGIC_ORDER.indexOf(b.icon);
  if (indexA === -1) indexA = 99;
  if (indexB === -1) indexB = 99;
  return indexA - indexB;
});

const currentPage = Number(Astro.params.page);
const allVisibleEssays = await getVisibleEssays();
const easelEssays = allVisibleEssays.filter(essay => essay.data.section === 'easel');
const totalPages = getTotalPages(easelEssays.length, PAGE_SIZE_ESSAY);

if (!Number.isInteger(currentPage) || currentPage <= 1 || currentPage > totalPages) {
  throw new Error(`Unknown easel page: ${Astro.params.page ?? ''}`);
}

const pageEssays = getPageSlice(easelEssays, currentPage, PAGE_SIZE_ESSAY);
---

<EssayPageView
  items={pageEssays}
  resultCount={easelEssays.length}
  currentPage={currentPage}
  totalPages={totalPages}
  prevPath={currentPage === 2 ? `/easel/` : `/easel/page/${currentPage - 1}/`}
  nextPath={currentPage < totalPages ? `/easel/page/${currentPage + 1}/` : null}
  titleOverride="The Easel"
  indexUrlOverride="/easel/index.json"
  socialItems={socialItems}
/>