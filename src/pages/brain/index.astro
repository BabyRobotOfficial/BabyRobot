---
import EssayPageView from '../../components/EssayPageView.astro';
import { getPageSlice, getTotalPages, getVisibleEssays } from '../../lib/content';
import { PAGE_SIZE_ESSAY } from '../../../site.config.mjs';
import { getThemeSettings } from '../../lib/theme-settings';

const { settings } = getThemeSettings();

const baseResolvedItems = settings.site.socialLinks.resolvedSocialItems.filter((item) => item.visible);
const STRATEGIC_ORDER = ['substack', 'spotify', 'x', 'instagram', 'youtube', 'email', 'kofi'];

const socialItems = baseResolvedItems.map((item) => ({
  key: item.id,
  href: item.href,
  label: item.label,
  title: item.label,
  icon: item.iconKey
})).sort((a, b) => {
  let indexA = STRATEGIC_ORDER.indexOf(a.icon);
  let indexB = STRATEGIC_ORDER.indexOf(b.icon);
  if (indexA === -1) indexA = 99;
  if (indexB === -1) indexB = 99;
  return indexA - indexB;
});

const allVisibleEssays = await getVisibleEssays();
const brainEssays = allVisibleEssays.filter(essay => essay.data.section === 'brain');
const totalPages = getTotalPages(brainEssays.length, PAGE_SIZE_ESSAY);
const currentPage = 1;
const pageEssays = getPageSlice(brainEssays, currentPage, PAGE_SIZE_ESSAY);
---

<EssayPageView
  items={pageEssays}
  resultCount={brainEssays.length}
  currentPage={currentPage}
  totalPages={totalPages}
  prevPath={null}
  nextPath={currentPage < totalPages ? `/brain/page/${currentPage + 1}/` : null}
  titleOverride="The Brain"
  indexUrlOverride="/brain/index.json"
  socialItems={socialItems}
/>