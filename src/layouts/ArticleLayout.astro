---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from './BaseLayout.astro';
import UiIcon from '../components/UiIcon.astro';
import Lightbox from '../components/Lightbox.astro';
import PodcastPlayer from '../components/PodcastPlayer.astro'; 
import '../styles/article.css';
import { getEssayDerivedText, type EssayEntry } from '../lib/content';
import type { ArticleMetaSettings, SidebarNavId } from '../lib/theme-settings';
import { formatISODateUtc } from '../utils/format';
import { truncateText } from '../utils/excerpt';

type ArticleNeighborLink = {
  href: string;
  title: string;
};

const {
  entry,
  prev,
  next,
  articleMetaSettings,
  visibleTags = []
} = Astro.props as {
  entry: EssayEntry;
  prev: ArticleNeighborLink | null;
  next: ArticleNeighborLink | null;
  articleMetaSettings: ArticleMetaSettings;
  visibleTags?: string[];
};

const audioUrl = entry?.data?.audioUrl ?? null;
const spotifyUrl = entry?.data?.spotifyUrl ?? null;
const author = entry?.data?.author ?? null;
const subtitle = entry?.data?.subtitle ?? null;

const entryTags: string[] = entry?.data?.tags ?? [];
const defaultImage = '/og.svg';
const coverImage = entry?.data?.cover ?? null; 
const ogImage = coverImage ?? defaultImage;

// 🎯 THE SMART SUFFIX CHECKER (_light ⇄ _dark variant)
// 🎯 THE BULLETPROOF SUFFIX CHECKER
let darkCoverImage = null;
if (coverImage && coverImage.includes('_light')) {
  // 1. Swap '_light' directly for '_dark'
  const darkPathGenerated = coverImage.replace('_light', '_dark');
  
  // 2. Remove the leading slash so Node doesn't look at your C:/ root drive
  // (Changes "/images/..." to "images/...")
  const cleanRelativePath = darkPathGenerated.startsWith('/') 
    ? darkPathGenerated.slice(1) 
    : darkPathGenerated;
  
  // 3. Pin it firmly to your project's local public directory
  const absolutePublicPath = path.join(process.cwd(), 'public', cleanRelativePath);
  
  // 4. Test if the physical file is actually there
  if (fs.existsSync(absolutePublicPath)) {
    darkCoverImage = darkPathGenerated;
  }
  console.log("🔍 HARD DRIVE FILE CHECK:", { absolutePublicPath, fileExists: fs.existsSync(absolutePublicPath), darkCoverImage });
} 

const derivedText = getEssayDerivedText(entry);
const rawDescription = entry?.data?.description?.trim?.() ?? '';
const description = rawDescription || truncateText(derivedText.excerpt, 90);
const activeNavId: SidebarNavId = entry?.data?.archive === false ? 'essay' : 'archive';
const articleReadingStats = articleMetaSettings.showWordCount || articleMetaSettings.showReadingTime
  ? (() => {
      // Clean up edge spaces and split by any number of consecutive whitespaces
      const cleanText = derivedText.plainText.trim();
      const wordCount = cleanText === '' ? 0 : cleanText.split(/\s+/).length;
      
      return {
        wordCount,
        readingMinutes: Math.max(1, Math.ceil(wordCount / 225))
      };
    })()
  : { wordCount: 0, readingMinutes: 0 };
const numberFormatter = new Intl.NumberFormat('en-US');
const shouldShowMetaLine = articleMetaSettings.showDate
  || (articleMetaSettings.showTags && visibleTags.length > 0)
  || articleMetaSettings.showWordCount
  || articleMetaSettings.showReadingTime
  || author;

---

<BaseLayout
  title={entry.data.title}
  description={description}
  image={ogImage}
  ogType="article"
  bodyClass="article-page immersive-page"
  activeNavId={activeNavId}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={entry.data.date.toISOString()} />
    {author ? <meta property="article:author" content={author} /> : null}
    {entryTags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>
  
<div class="article-header reader-exit-anchor">
    <h1 class="page-title">{entry.data.title}</h1>
    
    {subtitle ? (
      <p class="page-subtitle">{subtitle}</p>
    ) : null}
    <button
      id="reader-exit"
      class="icon-button reader-exit"
      type="button"
      aria-label="Exit reading mode"
      title="Exit reading mode"
      aria-hidden="true"
      tabindex="-1"
    >
      <UiIcon name="reader-exit" class="icon" />
    </button>
    
    {shouldShowMetaLine ? (
      <div class="meta-line meta-line--items" style="display: flex; flex-direction: column; gap: 6px; align-items: flex-start;">
        
        <div class="meta-line__row-stats" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
          {articleMetaSettings.showDate ? (
            <span class="meta-line__item">
              {formatISODateUtc(entry.data.date)}
            </span>
          ) : null}

          {author ? (
            <span class="meta-line__item article-author-name">
              by {author}
            </span>
          ) : null}

          {false ? (
            <span class="meta-line__item meta-line__item--desktop-meta">
              {numberFormatter.format(articleReadingStats.wordCount)} words
            </span>
          ) : null}

          {articleMetaSettings.showReadingTime ? (
            <span class="meta-line__item meta-line__item--desktop-meta">
              {numberFormatter.format(articleReadingStats.readingMinutes)} min. read
            </span>
          ) : null}
        </div>

        {articleMetaSettings.showTags && visibleTags.length ? (
          <div class="meta-line__row-tags" style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px;">
            {visibleTags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        ) : null}

      </div>
    ) : null}
  </div>

<!-- 🎯 AUTOMATIC LIGHT/DARK CLASS SWITCHER -->
{coverImage && (
  <div class="essay-cover-container">
    {darkCoverImage ? (
      <div class="theme-aware-cover-wrapper">
        <!-- ☀️ Light version: visible by default, hidden when .dark class is active -->
        <img src={coverImage} alt={`Cover art for ${entry.data.title}`} class="essay-hero-img light-cover-only" />
        
        <!-- 🌙 Dark version: hidden by default, visible only when .dark class is active -->
        <img src={darkCoverImage} alt={`Cover art for ${entry.data.title}`} class="essay-hero-img dark-cover-only" />
      </div>
    ) : (
      <!-- 🖼️ Fallback: No custom _dark file exists? Just show the main file everywhere -->
      <img src={coverImage} alt={`Cover art for ${entry.data.title}`} class="essay-hero-img" />
    )}
  </div>
)}

  {audioUrl && (
    <div style="margin: 1.5rem 0;">
      <PodcastPlayer 
        title={`Listen to: ${entry.data.title}`} 
        audioUrl={audioUrl} 
        spotifyUrl={spotifyUrl}
      />
    </div>
  )}

  <div class="prose">
    <slot />
  </div>

  {(prev || next) ? (
    <nav class="prev-next" aria-label="Article Navigation">
      <div class="prev-next__item">
        {prev ? (
          <a class="prev-next__link prev-next__link--prev" href={prev.href} rel="prev">
            <span class="prev-next__label">Previous</span>
            <span class="prev-next__title">{prev.title}</span>
          </a>
        ) : (
          <span class="prev-next__placeholder" aria-hidden="true"></span>
        )}
      </div>
      <div class="prev-next__item">
        {next ? (
          <a class="prev-next__link prev-next__link--next" href={next.href} rel="next">
            <span class="prev-next__label">Next</span>
            <span class="prev-next__title">{next.title}</span>
          </a>
        ) : (
          <span class="prev-next__placeholder" aria-hidden="true"></span>
        )}
      </div>
    </nav>
  ) : null}

  <Lightbox
    id="lightbox"
    label="Image preview"
    enableZoom={false}
    enablePan={false}
    enableSwipeDownClose={false}
  />

  <script>
    import { initArticleLightbox, initCodeCopyButtons } from '../scripts/lightbox';

    initCodeCopyButtons();
    initArticleLightbox({
      dialogId: 'lightbox',
      containerSelector: '.prose',
      enableZoom: false,
      enablePan: false,
      enableSwipeDownClose: false
    });
  </script>
</BaseLayout>

<style>
  .essay-cover-container {
    width: 100%;
    overflow: hidden;
  }

  .essay-hero-img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  /* 🎯 THE LIGHT/DARK VISIBILITY MATRIX */
  
  /* By default, hide the dark version */
  .dark-cover-only {
    display: none !important;
  }

  /* When the theme switcher applies the global dark class to the site container... */
  :global(.dark) .light-cover-only,
  :global([data-theme="dark"]) .light-cover-only {
    display: none !important;
  }

  :global(.dark) .dark-cover-only,
  :global([data-theme="dark"]) .dark-cover-only {
    display: block !important;
  }
</style>