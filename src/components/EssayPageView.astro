---
import BaseLayout from '../layouts/BaseLayout.astro';
import TagFilterHeader from './TagFilterHeader.astro';
import EssayCard from './EssayCard.astro';
import { createWithBase, getEssayDerivedText, getEssaySlug, type EssayEntry } from '../lib/content';
import { getThemeSettings, getVisibleArticleMetaTags } from '../lib/theme-settings';
import { joinPageSubtitleText } from '../utils/format';

const {
  currentPage,
  items,
  nextPath = null,
  prevPath = null,
  resultCount,
  totalPages,
  titleOverride = null,
  indexUrlOverride = "/essay/index.json",
  socialItems = []
} = Astro.props as {
  currentPage: number;
  items: EssayEntry[];
  nextPath?: string | null;
  prevPath?: string | null;
  resultCount: number;
  totalPages: number;
  titleOverride?: string | null;
  indexUrlOverride?: string;
  socialItems?: any[];
};

const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);
const {
  settings: {
    page,
    ui: { articleMeta }
  }
} = getThemeSettings();

const pageTitleText = titleOverride || page.essay.title || 'The Heart';
const pageTitleParts = [pageTitleText, currentPage > 1 ? `Page ${currentPage}` : null].filter(Boolean);
const pageTitle = pageTitleParts.join(' · ');
const subtitleText = joinPageSubtitleText(
  page.essay.subtitle,
  `Total: ${resultCount} ${resultCount === 1 ? 'article' : 'articles'}`,
  totalPages > 1 ? `Page ${currentPage} / ${totalPages}` : null
);
const pageDescription = joinPageSubtitleText(
  `${pageTitleText} List`,
  page.essay.subtitle,
  `Total: ${resultCount} ${resultCount === 1 ? 'article' : 'articles'}`,
  totalPages > 1 ? `Page ${currentPage} / ${totalPages}` : null
) ?? `${pageTitleText} List`;
const fallbackListId = 'essay-tag-list';
---

<BaseLayout title={pageTitle} description={pageDescription} bodyClass="essay-page">
<div
    class="entry-filters"
    data-entry-filters
    data-index-url={indexUrlOverride}
  >
    <TagFilterHeader
      pageTitleText={pageTitleText}
      subtitleText={subtitleText}
      rssHref={withBase('/essay/rss.xml')}
      pickerHref={`#${fallbackListId}`}
      fallbackListId={fallbackListId}
      dialogTitleId="essay-tag-dialog-title"
      searchAriaLabel={`Search ${pageTitleText}`}
      headerClass="page-header page-header--essay page-header--with-search"
      socialItems={socialItems}
    />
  </div>

  <div class="list">
    {items.map((entry) => (
      <EssayCard
        href={withBase(`/archive/${getEssaySlug(entry)}/`)}
        slug={getEssaySlug(entry)}
        title={entry.data.title}
        excerpt={getEssayDerivedText(entry).excerpt}
        date={entry.data.date}
        visibleTags={getVisibleArticleMetaTags(entry.data.tags, 'list')}
        articleMetaSettings={articleMeta}
        badge={entry.data.badge}
        cover={entry.data.cover}
      />
    ))}
  </div>

  {totalPages > 1 ? (
    <nav class="pagination" aria-label={`${pageTitleText} Pagination`}>
      <div class="pagination__inner">
        {prevPath ? <a class="pagination__link" rel="prev" href={withBase(prevPath)}>Previous</a> : null}
        {nextPath ? (
          <a class="pagination__link pagination__link--next" rel="next" href={withBase(nextPath)}>Next</a>
        ) : null}
      </div>
    </nav>
  ) : null}

  <script>
    import '../scripts/entry-search.ts';
  </script>
</BaseLayout>